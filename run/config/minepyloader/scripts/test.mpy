public load void testText():
    String[] str = ["123"]

    for (int i = 0; i < str.size(); i ++):
        Logger.log(str[0], boldText("text") )

public Text boldText(String msg):
    Text text = Text.new(msg)
    text.styled(getBold())
    return text

public Style getBold():
    Style style = Style.new()
    style.setBold(true)
    style.setColor("red")
    return style

public executable void run(Player p, String text):
    p.run(text)
    String msg = "已执行: " + text
    p.send(boldText(msg))